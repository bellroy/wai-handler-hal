{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": [
    "haskell-cabal",
    "nix",
    "github-actions"
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Schedule updates for all packages on Sundays",
      "matchPackageNames": ["**"],
      "schedule": ["on sunday"]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "enabled": false,
      "description": "GitHub Actions versions in generated workflows are managed centrally by bellroy-gha-bot (bellroy/gha-workflows), not Renovate."
    }
  ],
  "prHourlyLimit": 5
}
