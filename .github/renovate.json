{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "nix": {
    "enabled": true,
    "lockFileMaintenance": {
      "enabled": true,
      "schedule": ["* * 1-7 */2 *"]
    }
  },
  "packageRules": [
    {
      "description": "Schedule updates for all packages on Sundays",
      "matchPackageNames": ["**"],
      "schedule": ["on sunday"]
    },
    {
      "matchManagers": ["github-actions"],
      "enabled": false
    },
    {
      "matchManagers": ["nix"],
      "groupName": "nix"
    }
  ],
  "prHourlyLimit": 5
}
